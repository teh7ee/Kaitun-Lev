-- ===== Full Leviathan kill-timeout → local force respawn =====
do
    local SeenFullLevi = false
    local SpawnAt = 0
    local TimedOutThisSpawn = false
    local function ForceLocalRespawn(reason)
        print("[LeviathanTimeout]", reason)
        pcall(function()
            if SetStatus then
                SetStatus("利维坦超时未击杀 → 强制重生")
            end
        end)
        pcall(function()
            if SendNotify then
                SendNotify("Leviathan", "Timeout — forcing respawn")
            end
        end)
        task.spawn(function()
            for try = 1, 6 do
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    pcall(function()
                        hum.Health = 0
                    end)
                    pcall(function()
                        if char.BreakJoints then
                            char:BreakJoints()
                        end
                    end)
                else
                    break
                end
                task.wait(0.8)
            end
        end)
    end
    task.spawn(function()
        while true do
            task.wait(1.25)
            if not _G.LeviathanTimeoutReset then
                SeenFullLevi = false
                SpawnAt = 0
                TimedOutThisSpawn = false
            else
                local model = nil
                pcall(function()
                    model = select(1, SeaAPI.Leviathan_Find())
                end)
                local alive = false
                if model then
                    local dead = false
                    pcall(function()
                        dead = SeaAPI.Leviathan_IsDead(model)
                    end)
                    alive = not dead
                end
                if alive then
                    if not SeenFullLevi then
                        SeenFullLevi = true
                        SpawnAt = os.clock()
                        TimedOutThisSpawn = false
                        print("[LeviathanTimeout] full Leviathan detected — timer start",
                            tonumber(_G.LeviathanKillTimeoutMin) or 15, "min")
                    elseif not TimedOutThisSpawn then
                        local limit = (tonumber(_G.LeviathanKillTimeoutMin) or 15) * 60
                        if SpawnAt > 0 and (os.clock() - SpawnAt) >= limit then
                            TimedOutThisSpawn = true
                            ForceLocalRespawn("full Leviathan alive > timeout")
                        end
                    end
                else
                    if SeenFullLevi then
                        print("[LeviathanTimeout] full Leviathan gone/dead — cancel timer, continue flow")
                    end
                    SeenFullLevi = false
                    SpawnAt = 0
                    TimedOutThisSpawn = false
                end
            end
        end
    end)
end
