            if token ~= EnchantRunToken then return end
            EnchantPending = false
            EnchantRetryAt = 0
            EnchantArmedHeart = nil
            EnchantBeatAt = 0
            EnchantLockAt = 0
            SaveConfig()
            SetBusy(false)
