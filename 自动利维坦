        end
        if os.clock() - LastFind >= 0.4 then
            LastFind = os.clock()
            model, part = Leviathan_Find()
            if model then
                MissingSince = nil
                if Leviathan_IsDead(model) then
                    Killed = true
                    break
                end
            else
