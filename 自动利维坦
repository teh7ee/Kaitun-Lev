                    end
                    if hrp2 and FleeY then
                        hrp2.CFrame = CFrame.new(hrp2.Position.X, FleeY, hrp2.Position.Z)
                    end
                    task.wait(0.2)
                end
                task.wait(0.5)
            end
            if model then
