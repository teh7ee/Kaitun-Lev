        dist = flat.Magnitude
    end
    if os.clock() - CruiseCheckAt >= 15 then
        if CruiseCheckPos
            and Vector3.new(pos.X - CruiseCheckPos.X, 0, pos.Z - CruiseCheckPos.Z).Magnitude < 200 then
            CruiseStalls = CruiseStalls + 1
            if CruiseStalls >= 2 then
                CruiseStalls = 0
                CruiseCheckPos = nil
